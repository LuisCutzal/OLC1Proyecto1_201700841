
/*--------------- 1ra Area: Codigo de Usuario -----------------------*/
//-------> importaciones, paquetes
package AnalizadoresJS;
import java_cup.runtime.Symbol;
import javax.swing.JOptionPane;

import com.mycompany.proyecto1_2021s2.Nodo;
import com.mycompany.proyecto1_2021s2.error;
import com.mycompany.proyecto1_2021s2.Ventana;
//------> Codigo para el parser,variables, metodos
parser code{:
        public String resultado = "";
        public static Nodo raiz; 
        
        public Nodo getRaiz(){
            return raiz;
        }

        public void syntax_error(Symbol s)
        {
            System.err.println("Error en la Linea " + (s.right+1) +" Columna "+(s.left+1)+ ". Identificador "+s.value + " no reconocido. Se ha recuperado del error." );
            error nuevo = new error("Error Sintactico (Recuperado)", s.value.toString(), s.right+1, s.left+1);
            Ventana.listaErrores.add(nuevo);
        }
        public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception
        {
            System.err.println("Error en la Linea " + (s.right+1)+ " Columna "+(s.left+1)+". Identificador " +s.value + " no reconocido. No se Recupero");
            error nuevo = new error("Error Sintactico", s.value.toString(), s.right+1, s.left+1);
            Ventana.listaErrores.add(nuevo);
        }

 :}


//------> Codigo para las acciones gramaticales
action code
{:  :}

/*--------------- 2da Area: Declaraciones -----------------------*/

//------> declaracion de terminales 

terminal String llaveabre,llavecierra;
terminal String dospuntos,puntoycoma,coma;
terminal String comilladoble, comillasimple;
terminal String numero,cadena,id,decimal, guion;
terminal String parentesisC, parentesisA,igual,unario;

terminal String punto,menorque,mayorque;


terminal String mas,menos,multiplicacion,division,modulo;


terminal String class_js,Class_js,require,true_js,false_js,if_js,else_js;
terminal String for_js,while_js,do_js,switch_js,case_js,break_js,default_js;
terminal String console_js, log_js;

terminal String var_js,let_js,const_js;

terminal String and, or, not,menorIgual,mayorIgual,diferente,incremento,decremento,potencia,igualacion;

//------> declaracion de no terminales

non terminal Nodo INICIO;
non terminal Nodo CLASES,CLASE;
non terminal Nodo INSTRUCCION;
non terminal Nodo INSTRUCCIONES;
non terminal Nodo IMPORT,METODO,DECLARACIONVARIABLES,ASIGNACIONVARIABLES;
non terminal Nodo SENTENCIAIF,SENTENCIAFOR,SENTENCIAWHILE,SENTENCIADOWHILE,SENTENCIASWITCH;
non terminal Nodo CONSOLA,BREAK,LLAMADA;
non terminal Nodo TIPO;
non terminal Nodo PARAMETROS;
non terminal Nodo DECLARACIONFOR,CONTADOR;
non terminal Nodo CASOS,CASO;
non terminal Nodo EXPRESION;
//------> precedencia de menor a mayor

precedence left menorque, mayorque;
precedence left mas, menos;
precedence left multiplicacion, division;
precedence left modulo;
precedence right unario;

precedence left igualacion;
precedence left diferente;
precedence left menorIgual;
precedence left mayorIgual;
precedence left and;
precedence left or;
precedence left potencia;




start with INICIO;

/*--------------- 3ra Area: Reglas Semanticas -----------------------*/

INICIO::= CLASES:a                                                                                          {: parser.raiz = a;:}
    | error INICIO
    ;
CLASES::= CLASES:a CLASE:b                                                                                  {: Nodo padre = new Nodo("CLASES","",0,0);
                                                                                                               padre.AddHijo(a);
                                                                                                               padre.AddHijo(b);
                                                                                                               RESULT = padre;
                                                                                                            :}
    |CLASE:a                                                                                                {: Nodo padre = new Nodo("CLASES","",0,0);
                                                                                                               padre.AddHijo(a);
                                                                                                               RESULT = padre;
                                                                                                            :}
    ;
CLASE::= class_js:a id:b parentesisA:c parentesisC:d llaveabre:e INSTRUCCIONES:f llavecierra:g             {: Nodo padre = new Nodo("CLASE","",0,0);
                                                                                                              padre.AddHijo(new Nodo("class_js",a, aright, aleft));
                                                                                                              padre.AddHijo(new Nodo("id",b, bright, bleft));
                                                                                                              padre.AddHijo(new Nodo("parentesisA",c, cright, cleft));
                                                                                                              padre.AddHijo(new Nodo("parentesisC",d, dright, dleft));
                                                                                                              padre.AddHijo(new Nodo("llaveabre",e, eright, eleft));
                                                                                                              padre.AddHijo(f);
                                                                                                              padre.AddHijo(new Nodo("llavecierra",g, gright, gleft));
                                                                                                              RESULT = padre;
                                                                                                            :}
    | class_js:a id:b llaveabre:c INSTRUCCIONES:d llavecierra:e                                            {: Nodo padre = new Nodo("CLASE","",0,0);
                                                                                                              padre.AddHijo(new Nodo("class_js",a, aright, aleft));
                                                                                                              padre.AddHijo(new Nodo("id",b, bright, bleft));
                                                                                                              padre.AddHijo(new Nodo("llaveabre",c, cright, cleft));
                                                                                                              padre.AddHijo(d);
                                                                                                              padre.AddHijo(new Nodo("llavecierra",e, eright, eleft));
                                                                                                            :}
    | Class_js:a id:b parentesisA:c parentesisC:d llaveabre:e INSTRUCCIONES:f llavecierra:g                 {: Nodo padre = new Nodo("CLASE","",0,0);
                                                                                                              padre.AddHijo(new Nodo("Class_js",a, aright, aleft));
                                                                                                              padre.AddHijo(new Nodo("id",b, bright, bleft));
                                                                                                              padre.AddHijo(new Nodo("parentesisA",c, cright, cleft));
                                                                                                              padre.AddHijo(new Nodo("parentesisC",d, dright, dleft));
                                                                                                              padre.AddHijo(new Nodo("llaveabre",e, eright, eleft));
                                                                                                              padre.AddHijo(f);
                                                                                                              padre.AddHijo(new Nodo("llavecierra",g, gright, gleft));
                                                                                                              RESULT = padre;
                                                                                                            :}
    | Class_js:a id:b llaveabre:c INSTRUCCIONES:d llavecierra:e                                            {: Nodo padre = new Nodo("CLASE","",0,0);
                                                                                                              padre.AddHijo(new Nodo("Class_js",a, aright, aleft));
                                                                                                              padre.AddHijo(new Nodo("id",b, bright, bleft));
                                                                                                              padre.AddHijo(new Nodo("llaveabre",c, cright, cleft));
                                                                                                              padre.AddHijo(d);
                                                                                                              padre.AddHijo(new Nodo("llavecierra",e, eright, eleft));
                                                                                                            :}
    ;


INSTRUCCIONES::=INSTRUCCIONES:a INSTRUCCION:b                               {:  Nodo padre = new Nodo("INSTRUCCIONES","",0,0);
                                                                                padre.AddHijo(a);
                                                                                padre.AddHijo(b);
                                                                                RESULT = padre;
                                                                            :}
    |INSTRUCCION:a                                                          {:  Nodo padre = new Nodo("INSTRUCCIONES","",0,0);
                                                                                padre.AddHijo(a);
                                                                                RESULT = padre;
                                                                            :}
    ;


INSTRUCCION::=IMPORT:a                                                      {:  RESULT = a; :}
    |METODO:a                                                               {:  RESULT = a; :}
    |DECLARACIONVARIABLES:a                                                 {:  RESULT = a; :}
    |ASIGNACIONVARIABLES:a                                                  {:  RESULT = a; :}
    |SENTENCIAIF:a                                                          {:  RESULT = a; :}
    |SENTENCIAFOR:a                                                         {:  RESULT = a; :}
    |SENTENCIAWHILE:a                                                       {:  RESULT = a; :}
    |SENTENCIADOWHILE:a                                                     {:  RESULT = a; :}
    |SENTENCIASWITCH:a                                                      {:  RESULT = a; :}
    |CONSOLA:a                                                              {:  RESULT = a; :}
    |BREAK:a                                                                {:  RESULT = a; :}
    |LLAMADA:a                                                              {:  RESULT = a; :}
    |error
    ;

IMPORT::= TIPO:a id:b igual:c require:d parentesisA:e cadena:f parentesisC:g puntoycoma:h                   {: Nodo padre = new Nodo("IMPORT","",0,0);
                                                                                                               padre.AddHijo(a);
                                                                                                               padre.AddHijo(new Nodo("id",b, bright, bleft));
                                                                                                               padre.AddHijo(new Nodo("igual",c, cright, cleft));
                                                                                                               padre.AddHijo(new Nodo("require",d, dright, dleft));
                                                                                                               padre.AddHijo(new Nodo("parentesisA",e, eright, eleft));
                                                                                                               padre.AddHijo(new Nodo("cadena",f, fright, fleft));
                                                                                                               padre.AddHijo(new Nodo("parentesisC",g, gright, gleft));
                                                                                                               padre.AddHijo(new Nodo("puntoycoma",h, hright, hleft));
                                                                                                               RESULT = padre;
                                                                                                            :}
    | TIPO:a id:b igual:c require:d parentesisA:e cadena:f parentesisC:g                                    {: Nodo padre = new Nodo("IMPORT","",0,0);
                                                                                                               padre.AddHijo(a);
