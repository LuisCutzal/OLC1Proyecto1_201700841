ASIGNACIONVARIABLES::= id:a igual:b EXPRESION:c puntoycoma:d                {:  Nodo padre= new Nodo("ASIGNACIONVARIABLES","",0,0);
                                                                                padre.AddHijo(new Nodo("id",a, aright, aleft));
