                                                                            :}
        |not:a EXPRESION:b                                                  {:  Nodo padre = new Nodo("EXPRESION", "", 0,0); 
                                                                                padre.AddHijo(new Nodo("not", a, bright, bleft));
                                                                                padre.AddHijo(b);
                                                                                RESULT = padre;
