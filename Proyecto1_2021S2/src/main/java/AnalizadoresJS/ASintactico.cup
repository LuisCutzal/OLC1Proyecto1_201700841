        |menos:a EXPRESION:b                                                {:  Nodo padre = new Nodo("EXPRESION", "", 0,0); 
                                                                                padre.AddHijo(new Nodo("menos", a, aright, aleft));
                                                                                padre.AddHijo(b);
                                                                                RESULT = padre;                                         
                                                                            :} %prec unario
        |true_js:a                                                          {:  Nodo padre = new Nodo("EXPRESION", "", 0, 0);
                                                                                Nodo hijo = new Nodo("true_js", a, aright, aleft);
                                                                                padre.AddHijo(hijo);
