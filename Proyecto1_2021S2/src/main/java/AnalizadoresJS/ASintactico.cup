SENTENCIAIF::= if_js:a parentesisA:b EXPRESION:c parentesisC:d llaveabre:e INSTRUCCIONES:f llavecierra:g  {: Nodo padre= new Nodo("SENTENCIAIF","",0,0);
                                                                                                             padre.AddHijo(new Nodo("if_js",a, aright, aleft));
                                                                                                             padre.AddHijo(new Nodo("parentesisA",b, bright, bleft));
                                                                                                             padre.AddHijo(c);
                                                                                                             padre.AddHijo(new Nodo("parentesisC",d, dright, dleft));
                                                                                                             padre.AddHijo(new Nodo("llaveabre",e, eright, eleft));
                                                                                                             padre.AddHijo(f);
                                                                                                             padre.AddHijo(new Nodo("llavecierra",g, gright, gleft));
                                                                                                             RESULT= padre;
                                                                                                          :}
    | if_js:a parentesisA:b EXPRESION:c parentesisC:d llaveabre:e INSTRUCCIONES:f llavecierra:g else_js:h SENTENCIAIF:i  {: Nodo padre= new Nodo("SENTENCIAIF","",0,0);
                                                                                                                            padre.AddHijo(new Nodo("if_js",a, aright, aleft));
                                                                                                                            padre.AddHijo(new Nodo("parentesisA",b, bright, bleft));
                                                                                                                            padre.AddHijo(c);
                                                                                                                            padre.AddHijo(new Nodo("parentesisC",d, dright, dleft));
                                                                                                                            padre.AddHijo(new Nodo("llaveabre",e, eright, eleft));
                                                                                                                            padre.AddHijo(f);
                                                                                                                            padre.AddHijo(new Nodo("llavecierra",g, gright, gleft));
                                                                                                                            padre.AddHijo(new Nodo("else_js",h, hright, hleft));
                                                                                                                            padre.AddHijo(i);
                                                                                                                            RESULT=padre;
                                                                                                                         :}
    | if_js:a parentesisA:b EXPRESION:c parentesisC:d llaveabre:e INSTRUCCIONES:f llavecierra:g else_js:h llaveabre:i INSTRUCCIONES:j llavecierra:k  {: Nodo padre= new Nodo("SENTENCIAIF","",0,0);
