METODO::= id:a parentesisA:b PARAMETROS:c parentesisC:d llaveabre:e INSTRUCCIONES:f llavecierra:g           {: Nodo padre = new Nodo("METODO","",0,0);
                                                                                                               padre.AddHijo(new Nodo("id",a, aright, aleft));
