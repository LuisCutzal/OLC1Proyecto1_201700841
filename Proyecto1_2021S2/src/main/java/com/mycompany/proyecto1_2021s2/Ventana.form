            <Property name="text" type="java.lang.String" value="GernerarReporteEstadistico{&#xa;    compare(&quot;C:\u005cUsers\u005cDomingo\u005cDesktop\u005cUSAC\u005cSegundo Semestre 2021\u005cCompi1\u005clab\u005cPoyecto1\u005cEntrada\u005cproyecto1&quot;,&quot;C:\u005cUsers\u005cDomingo\u005cDesktop\u005cUSAC\u005cSegundo Semestre 2021\u005cCompi1\u005clab\u005cPoyecto1\u005cEntrada\u005cproyecto2&quot;);&#xa;    DefinirGlobales{&#xa;        string reporte1 = &quot;Probabilidades esperadas para Variables archivo archivo2vars.js&quot;;&#xa;        string reporte2 = &quot;Probabilidades obtenidos para Variables archivo archivo2vars.js&quot;;&#xa;&#xa;        double pe1 = 0;&#xa;        double pe2 = 1;&#xa;        double pe3 = 0;&#xa;        double pe4 = 1;&#xa;        double pe5 = 0;&#xa;        double pe6 = 1;&#xa;        double pe7 = 1;&#xa;&#xa;        double po1 = ${PuntajeEspecifico,&quot;archivo2vars.js&quot;,&quot;variable&quot;,&quot;punteo&quot;};&#xa;        double po2 = ${PuntajeEspecifico,&quot;archivo2vars.js&quot;,&quot;variable&quot;,&quot;validacion&quot;};&#xa;        double po3 = ${PuntajeEspecifico,&quot;archivo2vars.js&quot;,&quot;variable&quot;,&quot;aritmetica&quot;};&#xa;        double po4 = ${PuntajeEspecifico,&quot;archivo2vars.js&quot;,&quot;variable&quot;,&quot;punteo2&quot;};&#xa;        double po5 = ${PuntajeEspecifico,&quot;variables.js&quot;,&quot;variable&quot;,&quot;A&quot;};&#xa;        double po6 = ${PuntajeEspecifico,&quot;variables.js&quot;,&quot;variable&quot;,&quot;variable&quot;};&#xa;        double po7 = ${PuntajeEspecifico,&quot;variables.js&quot;,&quot;variable&quot;,&quot;compi1&quot;};&#xa;        &#xa;    }&#xa;&#xa;    GraficaBarras{&#xa;        Titulo: reporte1;&#xa;        Ejex: [ &quot;punteo&quot;, &quot;validacion&quot; , &quot;aritmetica&quot;, &quot;punteo2&quot; ];&#xa;        Valores: [ pe1, pe2, pe3, pe4 ];&#xa;        Titulox: &quot;Nombre de las variables&quot;;&#xa;        Tituloy: &quot;Puntaje&quot;;&#xa;    }&#xa;&#xa;    GraficaBarras{&#xa;        Titulo: reporte2;&#xa;        Ejex: [ &quot;punteo&quot;, &quot;validacion&quot; , &quot;aritmetica&quot;, &quot;punteo2&quot; ];&#xa;        Valores: [ po1, po2, po3, po4 ];&#xa;        Titulox: &quot;Nombre de las variables&quot;;&#xa;        Tituloy: &quot;Puntaje&quot;;&#xa;    }&#xa;}" containsInvalidXMLChars="true"/>
