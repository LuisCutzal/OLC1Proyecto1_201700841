
/*--------------- 1ra Area: Codigo de Usuario -----------------------*/
//-------> importaciones, paquetes
package Analizadores;
import java_cup.runtime.Symbol;

import com.mycompany.proyecto1_2021s2.Ventana;
import com.mycompany.proyecto1_2021s2.error;

import javax.swing.JOptionPane;
import java.util.LinkedList;
//------> Codigo para el parser,variables, metodos
parser code{:

        public void syntax_error(Symbol s)
        {
            System.err.println("Error en la Linea " + (s.right+1) +" Columna "+(s.left+1)+ ". Identificador "+s.value + " no reconocido. Se ha recuperado del error." );
            error nuevo = new error("Error Sintactico (Recuperado)", s.value.toString(), s.right+1, s.left+1);
            Ventana.listaErrores.add(nuevo);
        }
        public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception
        {
            System.err.println("Error en la Linea " + (s.right+1)+ " Columna "+(s.left+1)+". Identificador " +s.value + " no reconocido.");
            error nuevo = new error("Error Sintactico", s.value.toString(), s.right+1, s.left+1);
            Ventana.listaErrores.add(nuevo);
        }

 :}


//------> Codigo para las acciones gramaticales
action code
{:  :}

/*--------------- 2da Area: Declaraciones -----------------------*/

//------> declaracion de terminales 

terminal String llaveabre,llavecierra;
terminal Strinig dospuntos,puntoycoma,coma,dolar;
terminal String comilladoble, comillasimple;
terminal String numero,cadena,id,decimal,letra;
terminal String guion,guionBajo;
terminal String parentesisC, parentesisA,igual,corcheteC,corcheteA;

terminal String graficaBarras,titulo,ejeX,Valores,tituloX,tituloY;

terminal String generarReporteEstadistico,compare;

terminal String graficaPie;

terminal String graficaLineas, ar;

terminal String DefinirGlobales,string,dou;



//------> declaracion de no terminales

non terminal  INICIO, GENERARREPORTE;
non terminal  INSTRUCCIONES,INSTRUCCION;
non terminal  COMPARE,DEFINIRGLOBALES,GRAFICABARRAS,GRAFICAPIE,GRAFICASLINEAS;
non terminal  DEFINICIONVARIABLESG,DEFINICIONVARIABLEG,TIPO,VALORTIPO;
non terminal  INFOSBARRAS;
non terminal  INFOSLINEAS;
non terminal  INFOS,DATOS,VALORES,DATO;

//------> precedencia de menor a mayor



start with INICIO;

/*--------------- 3ra Area: Reglas Semanticas -----------------------*/

INICIO::= GENERARREPORTE                        {: :}
    ;

GENERARREPORTE::= generarReporteEstadistico  llaveabre INSTRUCCIONES  llavecierra                      {: :}
    ;

INSTRUCCIONES::=INSTRUCCIONES INSTRUCCION                                                               {: :}
    | INSTRUCCION                                                                                       {: :}
    ;

INSTRUCCION::= COMPARE                                                                                  {: :}
    |DEFINIRGLOBALES                                                                                    {: :}
    |GRAFICABARRAS                                                                                      {: :}
    |GRAFICAPIE                                                                                         
    |GRAFICASLINEAS                                                                                      
    ;

COMPARE::= compare parentesisA  cadena  coma   cadena   parentesisC  puntoycoma     
    ;

DEFINIRGLOBALES::= DefinirGlobales llaveabre DEFINICIONVARIABLESG llavecierra                           
    ;

DEFINICIONVARIABLESG::= DEFINICIONVARIABLESG DEFINICIONVARIABLEG                                        
    |DEFINICIONVARIABLEG                                                                                
    ;


DEFINICIONVARIABLEG::= TIPO id igual VALORTIPO puntoycoma                                                                                                                                              {: :}
    ;

TIPO::= string                                                                                          
    | dou                                                                                             
    ;

VALORTIPO::= cadena                                                                                                                                                                               
    |numero
    |decimal                                                                                            
    |dolar llaveabre id coma  cadena  coma cadena coma cadena llavecierra                                
    ;

GRAFICABARRAS::= graficaBarras llaveabre INFOSBARRAS llavecierra                                        {: :}
    ;

GRAFICASLINEAS::= graficaLineas llaveabre INFOSLINEAS  llavecierra
    ;

GRAFICAPIE::= graficaPie llaveabre INFOS llavecierra
    ;

INFOSBARRAS::=INFOSBARRAS titulo dospuntos id puntoycoma                                                {: :}
    |INFOSBARRAS ejeX dospuntos corcheteA DATOS  corcheteC puntoycoma                                   {: :}
    |INFOSBARRAS VALORES                                                                                {: :}
    |INFOSBARRAS tituloX dospuntos  cadena  puntoycoma                                                    {: :}
    |INFOSBARRAS tituloY dospuntos  cadena  puntoycoma                                                    {: :}
    |titulo dospuntos id puntoycoma                                                                     {: :}
    |ejeX dospuntos corcheteA DATOS  corcheteC puntoycoma                                               {: :}
    |tituloX dospuntos  cadena  puntoycoma                                                                {: :}
    |tituloY dospuntos  cadena  puntoycoma                                                                {: :}
    |VALORES                                                                                            {: :}
    ;

INFOSLINEAS::=INFOSLINEAS titulo dospuntos id puntoycoma                                                   {: :}
    |INFOSLINEAS ar dospuntos cadena puntoycoma                                                                {: :}
    |titulo dospuntos id puntoycoma
    |ar dospuntos cadena puntoycoma
    ;

INFOS::=INFOS titulo dospuntos id puntoycoma                                                            {: :}
    |INFOS ejeX dospuntos corcheteA DATOS  corcheteC puntoycoma                                         {: :}
    |INFOS VALORES                                                                                            {: :}
    |titulo dospuntos id puntoycoma                                                                     {: :}
    |ejeX dospuntos corcheteA DATOS  corcheteC puntoycoma                                               {: :}
    |VALORES                                                                                            {: :}
    ;

VALORES::= Valores dospuntos corcheteA DATOS  corcheteC puntoycoma                                      {: :}
    ;

DATOS::= DATOS coma DATO                                                                                {: :}
    |DATO                                                                                               {: :}
    ;

DATO::=decimal                                                                                          {: :}                                                                                         
    |numero
    |cadena                                                                                             {: :}
    |id                                                                                                 {: :}
    |dolar llaveabre id coma cadena coma cadena coma cadena llavecierra                                {: :}
    ;